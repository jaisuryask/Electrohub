# Copy to .env for local use (git-ignored). On Render, set these under Environment instead.
# Never commit real values.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Chat logs + feedback (MongoDB Atlas free cluster). Without it a local fallback file is used.
MONGODB_URI=
MONGODB_DB=electrolab

# Optional free AI keys (the site also works with no key via a keyless free model)
GROQ_API_KEY=
GEMINI_API_KEY=
# ELECTROLAB_AI=0   # force the built-in local engine only
